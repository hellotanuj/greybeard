# Required: Hindsight Cloud (https://ui.hindsight.vectorize.io) or a self-hosted server
HINDSIGHT_API_KEY=hsk_...
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Optional: any OpenAI-compatible LLM, used ONLY for the "without memory" baseline column.
# Without it, the baseline uses Hindsight reflect on an empty Day-1 bank (same config, no history).
# Groq:  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
# xAI:   LLM_BASE_URL=https://api.x.ai/v1              LLM_MODEL=grok-3-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional overrides
GREYBEARD_FLEET_BANK=greybeard-fleet
GREYBEARD_DAY1_BANK=greybeard-day1
GREYBEARD_REFLECT_BUDGET=mid
